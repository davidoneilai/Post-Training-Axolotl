# Copie para .env e preencha conforme necessário:
#   cp .env.example .env

# GPUs visíveis no container (ex.: "0" ou "0,1,2,3")
CUDA_VISIBLE_DEVICES=0

# Hugging Face — necessário para modelos gated (Llama, etc.)
HF_TOKEN=

# Weights & Biases (opcional)
WANDB_API_KEY=
WANDB_PROJECT=axolotl-sft

# Cache local do Hugging Face no host
HF_HOME=~/.cache/huggingface
